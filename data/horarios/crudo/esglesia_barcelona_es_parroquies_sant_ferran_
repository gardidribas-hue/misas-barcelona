<style id="ebn-linked-banner-slider-style-2-inline-css">
.ebn-linked-banner-slider {
	background-color: var(--wp--preset--color--brand-tertiary-50);
	overflow: hidden;
}

.ebn-linked-banner-slider__container {
	display: flex;
	flex-direction: column;
	gap: var(--wp--preset--spacing--2-xl);
	max-width: var(--wp--custom--width--default);
	margin-inline: auto;
	padding-block: var(--wp--preset--spacing--2-xl);
}

.ebn-linked-banner-slider__carousel-wrapper {
	position: relative;
}

.ebn-linked-banner-slider__carousel {
	overflow: hidden;
}

.ebn-linked-banner-slider__slide {
	flex-shrink: 0;
}

.ebn-linked-banner-slider__slide-link {
	display: block;
	border-radius: var(--wp--custom--border-radius--xs);
	overflow: hidden;
	aspect-ratio: 1 / 1;
}

.ebn-linked-banner-slider__slide-image {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.ebn-linked-banner-slider__arrows {
	position: absolute;
	inset-inline: 0;
	top: 50%;
	transform: translateY(-50%);
	z-index: 2;
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding-inline: var(--wp--preset--spacing--xs);
	pointer-events: none;
}

.ebn-linked-banner-slider__arrow {
	pointer-events: auto;
}

.ebn-linked-banner-slider__nav {
	display: flex;
	justify-content: center;
	margin-block-start: var(--wp--preset--spacing--l);
}

.ebn-linked-banner-slider__nav .ebn-linked-banner-slider__pagination {
	display: flex;
	gap: var(--wp--preset--spacing--2-xs);
	position: static;
	justify-content: center;
}

.ebn-linked-banner-slider__pagination .ob-slider-pagination__dot {
	background-color: var(--wp--preset--color--brand-primary-50);
}

.ebn-linked-banner-slider__pagination .ob-slider-pagination__item:not(.ob-slider-pagination__item--active) .ob-slider-pagination__dot {
	opacity: 0.3;
}

.ebn-linked-banner-slider__ctas {
	justify-content: center;
}

@media (min-width: 641px) {
	.ebn-linked-banner-slider__container {
		padding-inline: var(--wp--custom--grid--margin);
	}
}

@media (min-width: 1024px) {
	.ebn-linked-banner-slider__arrow.ob-nav-control--next {
		right: calc(-1 * var(--wp--preset--spacing--2-xl));
	}

	.ebn-linked-banner-slider__arrow.ob-nav-control--prev {
		left: calc(-1 * var(--wp--preset--spacing--2-xl));
	}
}

