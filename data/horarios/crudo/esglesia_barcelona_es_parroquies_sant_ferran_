<style id="ebn-parish-card-style-inline-css">
.ebn-parish-card {
	--_accordion-item-bg: var(--wp--preset--color--neutral-white);
	--_accordion-item-open-bg: var(--wp--preset--color--neutral-white);
	--ebn-parish-card-isologo-color: var(--wp--preset--color--neutral-10);
	--ebn-parish-card-isologo-icon: var(--icon-esglesia-isologo);
	--ebn-parish-card-isologo-right: -168px;
	--ebn-parish-card-isologo-bottom: -168px;
	--ebn-parish-card-isologo-width: 420px;
	--ebn-parish-card-isologo-aspect-ratio: 610 / 974;
	--parish-card-left-column-min: 280px;
	--parish-card-left-column-max: 420px;
	--aspect-ratio-map: 716 / 402;

	padding-block: var(--wp--preset--spacing--xl);
	padding-inline: var(--wp--preset--spacing--m);
	background-color: var(--wp--preset--color--brand-tertiary-10);
}

.ebn-parish-card__container {
	display: flex;
	flex-direction: column;
	gap: var(--wp--preset--spacing--2-xl);

	max-width: var(--wp--custom--width--default);
	margin-inline: auto;
}

.ebn-parish-card__header {
	display: flex;
	flex-direction: column;
	gap: var(--wp--preset--spacing--l);
	align-items: center;

	text-align: center;
}

.ebn-parish-card__title {
	color: var(--wp--preset--color--brand-primary-50);

	text-box-edge: cap;
	text-box-trim: trim-start;
}

.ebn-parish-card__title em {
	font-style: italic;
	color: var(--wp--preset--color--brand-secondary-50);
}

.ebn-parish-card__subtitle {
	max-width: var(--wp--custom--width--small);
	color: var(--wp--preset--color--brand-primary-40);
}

.ebn-parish-card__card {
	position: relative;

	overflow: hidden;
	display: grid;
	isolation: isolate;
	grid-template-columns: minmax(0, 1fr);

	gap: var(--wp--preset--spacing--3-xl);
	align-items: start;

	padding: var(--wp--preset--spacing--xl);
	border-radius: var(--wp--custom--border-radius--l, 40px);

	background-color: var(--wp--preset--color--neutral-white);
}

.ebn-parish-card__isologo {
	pointer-events: none;

	position: absolute;
	z-index: 0;
	right: var(--ebn-parish-card-isologo-right);
	bottom: var(--ebn-parish-card-isologo-bottom);

	display: block;

	aspect-ratio: var(--ebn-parish-card-isologo-aspect-ratio);
	width: var(--ebn-parish-card-isologo-width);

	background-color: var(--ebn-parish-card-isologo-color);

	mask: var(--ebn-parish-card-isologo-icon) center / contain no-repeat;
}

.ebn-parish-card__left {
	position: relative;
	z-index: 1;

	inline-size: 100%;
	min-width: 0;
	max-width: none;
}

.ebn-parish-card__right {
	position: relative;
	z-index: 1;

	display: flex;
	flex-direction: column;
	gap: var(--wp--preset--spacing--m);

	inline-size: 100%;
	min-width: 0;
}

.ebn-parish-card__info {
	display: flex;
	flex-direction: column;
	gap: var(--wp--preset--spacing--m);
	align-items: center;
}

.ebn-parish-card__info-header {
	width: 100%;
	padding-block: var(--wp--preset--spacing--s);
	border-bottom: 1px solid var(--wp--preset--color--brand-secondary-50);
}

.ebn-parish-card__info-title {
	color: var(--wp--preset--color--brand-primary-50);

	text-box-edge: cap;
	text-box-trim: trim-start;
}

.ebn-parish-card__accordion {
	width: 100%;
	padding-inline: var(--wp--preset--spacing--xs);
}

.ebn-parish-card__accordion .ob-accordion__item {
	width: 100%;
	padding: var(--wp--preset--spacing--m);
	border-bottom-color: var(--wp--preset--color--neutral-30);
}

.ebn-parish-card__accordion .ob-accordion__item:not(.is-collapsed) {
	border-bottom-color: transparent;
	border-radius: var(--wp--custom--border-radius--s);
}

.ebn-parish-card__accordion .ob-accordion__item-header button {
	gap: var(--wp--preset--spacing--l);
}

.ebn-parish-card__accordion-heading {
	color: var(--wp--preset--color--brand-secondary-50);
	text-box-edge: cap;
	text-box-trim: trim-both;
	transition: color 0.3s ease-out;
}

.ebn-parish-card__accordion .ob-accordion__item:not(.is-collapsed) .ebn-parish-card__accordion-heading {
	color: var(--wp--preset--color--brand-primary-50);
}

.ebn-parish-card__accordion .ob-accordion__item-panel {
	gap: var(--wp--preset--spacing--l);
}

.ebn-parish-card__accordion .ob-accordion__item:not(.is-collapsed) .ob-accordion__item-panel {
	margin-top: var(--wp--preset--spacing--m);
}

.ebn-parish-card__accordion .ob-accordion__item-icon {
	color: var(--wp--preset--color--brand-secondary-50);
}

.ebn-parish-card__accordion-content {
	color: var(--wp--preset--color--brand-primary-50);
}

.ebn-parish-card__document-button {
	margin-top: var(--wp--preset--spacing--2-xs);
}

.ebn-parish-card__map {
	overflow: hidden;
	border-radius: var(--wp--custom--border-radius--xs);
}

.ebn-parish-card__map-iframe {
	display: block;
	aspect-ratio: var(--aspect-ratio-map);
	width: 100%;
	border: 0;
}

@media (width >=782px) {

	.ebn-parish-card {
		padding-inline: var(--wp--custom--grid--margin);
	}
}

@media (width >=1024px) {

	.ebn-parish-card {
		--ebn-parish-card-isologo-right: -240px;
		--ebn-parish-card-isologo-bottom: -66px;
		--ebn-parish-card-isologo-width: 486px;

		padding-block: var(--wp--preset--spacing--2-xl);
	}

	.ebn-parish-card__card {
		grid-template-columns:
			minmax(var(--parish-card-left-column-min),
				var(--parish-card-left-column-max)) 1fr;
	}
}

/*# sourceURL=https://esglesia.barcelona/es/wp-content/plugins/esglesia-next/blocks/ebn-parish-card/style.css */
</style>
<style id="ebn-parish-contact-card-style-inline-css">
.ebn-parish-contact-card {
	--min-width-card: 320px;
	--max-width-card: 440px;
	--icon-size: 16px;

	overflow: hidden;
	display: grid;

	min-width: var(--min-width-card);
	max-width: var(--max-width-card);
	border-radius: var(--wp--custom--border-radius--s);

	background-color: var(--wp--preset--color--neutral-white);
}

.ebn-parish-contact-card__header-logo {
	display: grid;
	gap: var(--wp--preset--spacing--xs);
	padding: var(--wp--preset--spacing--m) var(--wp--preset--spacing--m) 0;
}

.ebn-parish-contact-card__company-logo {
	display: block;
	inline-size: min(100%, var(--max-width-card));
}

.ebn-parish-contact-card__company-mark {
	display: block;
	aspect-ratio: 420 / 111;
	inline-size: 100%;
	background: center / contain no-repeat var(--company-logo-image);
}

.ebn-parish-contact-card__media {
	padding: var(--wp--preset--spacing--m);
}

.ebn-parish-contact-card__media-card {
	position: relative;
	overflow: hidden;
	border-radius: var(--wp--custom--border-radius--s);
	background-color: var(--wp--preset--color--brand-tertiary-10);
}

.ebn-parish-contact-card__picture {
	position: relative;
	z-index: 1;

	overflow: hidden;
	display: block;

	width: 100%;
	height: 100%;
}

.ebn-parish-contact-card__image {
	display: block;

	width: 100%;
	height: 100%;

	object-fit: cover;
	object-position: center;
}

.ebn-parish-contact-card__body {
	display: grid;
	gap: var(--wp--preset--spacing--m);
	padding: var(--wp--preset--spacing--m);
}

.ebn-parish-contact-card__contact {
	display: grid;
	gap: var(--wp--preset--spacing--xs);

	margin: 0;
	padding: 0;

	list-style: none;
}

.ebn-parish-contact-card__contact-item {
	display: grid;
	grid-template-columns: var(--icon-size) minmax(0, 1fr);
	gap: var(--wp--preset--spacing--2-xs);
	align-items: center;
}

.ebn-parish-contact-card__contact-icon {
	display: inline-block;

	inline-size: var(--icon-size);
	block-size: var(--icon-size);

	color: var(--wp--preset--color--brand-primary-50);

	background-color: currentcolor;

	/* stylelint-disable-next-line property-no-vendor-prefix */
	-webkit-mask: var(--_icon-mask) center / contain no-repeat;
	mask: var(--_icon-mask) center / contain no-repeat;
}

.ebn-parish-contact-card__contact-text {
	color: var(--wp--preset--color--brand-primary-50);
}

.ebn-parish-contact-card__contact-text strong {
	margin-inline-end: var(--wp--preset--spacing--3-xs);
	font-weight: 600;
}

.ebn-parish-contact-card__contact-text a {
	color: var(--wp--preset--color--brand-secondary-50);
	text-decoration: underline;
}

.ebn-parish-contact-card__contact-text a:hover,
.ebn-parish-contact-card__contact-text a:focus-visible {
	color: var(--wp--preset--color--brand-primary-50);
}

.ebn-parish-contact-card__footer {
	padding-top: var(--wp--preset--spacing--m);
}

/*# sourceURL=https://esglesia.barcelona/es/wp-content/plugins/esglesia-next/blocks/ebn-parish-contact-card/style.css */
</style>
<style id="ebn-social-embeds-style-inline-css">
.ebn-social-embeds {
	background-color: var(--wp--preset--color--accent-green);
	padding-block: var(--wp--preset--spacing--l);
	padding-inline: var(--wp--preset--spacing--s);
	overflow: hidden;
}

.ebn-social-embeds__container {
	max-width: var(--wp--custom--width--default);
	margin-inline: auto;
	display: flex;
	flex-direction: column;
	gap: var(--wp--preset--spacing--l);
}

.ebn-social-embeds__header {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--wp--preset--spacing--m);
}

.ebn-social-embeds__heading {
	color: var(--wp--preset--color--brand-primary-50);
	text-align: center;
	margin: 0;
	max-width: var(--wp--custom--width--narrow);
	line-height: 1;
	text-box-trim: trim-both;
	text-box-edge: cap alphabetic;
}

.ebn-social-embeds__heading em {
	font-style: italic;
	color: var(--wp--preset--color--brand-secondary-50);
}

.ebn-social-embeds__description {
	color: var(--wp--preset--color--brand-primary-50);
	opacity: 0.6;
	text-align: center;
	margin: 0;
	max-width: var(--wp--custom--width--small);
}

.ebn-social-embeds__grid {
	display: grid;
	grid-template-columns: 1fr;
	gap: var(--wp--preset--spacing--s);
}

.ebn-social-embeds__card {
	display: flex;
	flex-direction: column;
	align-items: center;
	background-color: var(--wp--preset--color--neutral-white);
	border-radius: var(--wp--custom--border-radius--xs);
	padding: var(--wp--preset--spacing--m) var(--wp--preset--spacing--s);
	gap: var(--wp--preset--spacing--m);
	flex: 1 1 0;
	overflow: hidden;
}

.ebn-social-embeds__card-title {
	display: flex;
	align-items: center;
	justify-content: center;
	padding-block: var(--wp--preset--spacing--2-xs);
	width: 100%;
}

.ebn-social-embeds__card-title-text {
	color: var(--wp--preset--color--brand-primary-50);
	text-align: center;
	letter-spacing: 0;
	text-box-trim: trim-both;
	text-box-edge: cap alphabetic;
}

.ebn-social-embeds__card-embed {
	flex: 1;
	width: 100%;
	overflow: hidden;
}

.ebn-social-embeds__card-embed iframe {
	display: block;
	width: 100%;
	height: 100%;
	border: 0;
}

@media (min-width: 768px) {
	.ebn-social-embeds__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.ebn-social-embeds__card {
		flex: initial;
	}

	.ebn-social-embeds__card:last-child:nth-child(odd) {
		grid-column: 1 / -1;
		justify-self: center;
		width: calc(50% - (var(--wp--preset--spacing--s) / 2));
	}
}

@media (min-width: 1024px) {
	.ebn-social-embeds {
		padding: var(--wp--preset--spacing--2-xl);
	}

	.ebn-social-embeds__container {
		gap: var(--wp--preset--spacing--2-xl);
	}

	.ebn-social-embeds__grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--wp--preset--spacing--l);
	}

	.ebn-social-embeds__card:last-child:nth-child(odd) {
		grid-column: auto;
		justify-self: stretch;
		width: auto;
	}
}

/*# sourceURL=https://esglesia.barcelona/es/wp-content/plugins/esglesia-next/blocks/ebn-social-embeds/style.css */
</style>

