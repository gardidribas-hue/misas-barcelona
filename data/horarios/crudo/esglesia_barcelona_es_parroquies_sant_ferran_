<style id="ebn-google-calendar-style-inline-css">
.ebn-google-calendar {
	--_container-width: min(calc(100vw - var(--wp--custom--grid--margin) * 2), var(--wp--custom--width--default));

	padding-inline: var(--wp--custom--grid--margin);
	font-family: var(--font-family--secondary);
	color: var(--wp--preset--color--brand-primary-50);
	background-color: var(--wp--preset--color--neutral-05);
	overflow: hidden;
}

.ebn-google-calendar--simple {
	--_list-padding-block: 0;
	background-color: var(--wp--preset--color--neutral-05);
	padding-block: var(--wp--preset--spacing--2-xl);
}

.ebn-google-calendar__container {
	max-width: var(--wp--custom--width--default);
	margin-inline: auto;
}

.ebn-google-calendar__heading {
	text-align: center;
	text-box-trim: both;
	text-box-edge: cap alphabetic;
	color: var(--wp--preset--color--brand-primary-50);
	margin-block: 0;
}

.ebn-google-calendar__filter {
	margin-block: var(--wp--preset--spacing--l) 0;
	padding-block: var(--wp--preset--spacing--xs);
}

.ebn-google-calendar__filter-label {
	display: none;
}

.ebn-google-calendar__filter-options {
	display: none;
}

.ebn-google-calendar__filter-link {
	--_border-color: var(--bg-color);
}

.ebn-google-calendar__grid {
	display: none;
}

.ebn-google-calendar__list {
	display: grid;
	grid-template-columns: 1fr;
	padding-block: var(--wp--preset--spacing--l) 0;
	gap: var(--wp--preset--spacing--l);
	padding-block: var(--_list-padding-block, var(--wp--preset--spacing--2-xl));
	position: relative;
}

.ebn-google-calendar__list:before {
	--_side-margin: calc((100vw - var(--_container-width)) / 2);
	content: '';
	display: block;
	position: absolute;
	inset-block: 0;
	inset-inline: calc(-1 * var(--_side-margin));
	background-color: var(--wp--preset--color--neutral-05);
	z-index: 0;
}

.ebn-google-calendar__event {
	display: grid;
	grid-template-columns: clamp(88px, calc(3.5rem + 5.333vw), 120px) 1fr;
	position: relative;
	z-index: 1;
	border: 1px solid var(--wp--preset--color--brand-primary-30);
	border-radius: var(--wp--custom--border-radius--xs);
}

.ebn-google-calendar__event-date {
	border-radius: var(--wp--custom--border-radius--xs) 0 0 var(--wp--custom--border-radius--xs);
	padding: var(--wp--preset--spacing--m);
	border-inline-end: 4px solid var(--wp--preset--color--brand-primary-50);
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: end;
	gap: var(--wp--preset--spacing--s);
	text-align: end;
	color: var(--wp--preset--color--brand-primary-50);
}

.ebn-google-calendar__event-day-month {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--wp--preset--spacing--s);
}

.ebn-google-calendar__event-day {
	font-style: italic;
	line-height: 120%;
}

.ebn-google-calendar__event-month {
	font-weight: var(--font-weight--semibold);
	line-height: 120%;
}

.ebn-google-calendar__event-content {
	border-radius: 0 var(--wp--custom--border-radius--xs) var(--wp--custom--border-radius--xs) 0;
	background-color: var(--wp--preset--color--neutral-white);
	padding: var(--wp--preset--spacing--m);
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	gap: var(--wp--preset--spacing--m);
}

.ebn-google-calendar__event-heading {
	margin-block: 0;
	padding-block: var(--wp--preset--spacing--2-xs);
}

.ebn-google-calendar__event-meta {
	display: flex;
	flex-direction: column;
	gap: var(--wp--preset--spacing--3-xs);
}

.ebn-google-calendar__event-location {
	color: var(--wp--preset--color--brand-primary-40);
}

.ebn-google-calendar__event-link {
	font-weight: var(--font-weight--semibold);
	text-decoration: none;
	color: var(--wp--preset--color--brand-secondary-50);
}

.ebn-google-calendar__footer {
	text-align: center;
	padding-block: var(--wp--preset--spacing--l) 0;
}

.ebn-google-calendar__tooltip {
	display: none;
}

.ebn-google-calendar__filter-select {
	width: 100%;
	border-radius: var(--wp--custom--border-radius--s);
	background-color: var(--wp--preset--color--neutral-05);
	border: 1px solid var(--wp--preset--color--brand-primary-30);
	font-size: var(--wp--preset--font-size--2-xs);
	padding: 13px;
	font-weight: 400;
	color: var(--wp--preset--color--brand-primary-50);
}

@media(min-width:768px) {
	.ebn-google-calendar--full {
		background-color: transparent;
	}

	.ebn-google-calendar__filter {
		margin-block-end: var(--wp--preset--spacing--l);
	}

	.ebn-google-calendar__filter-select {
		display: none;
	}

	.ebn-google-calendar__filter-options {
		display: flex;
		list-style: none;
		padding-inline: 0;
		justify-content: center;
		gap: var(--wp--preset--spacing--xs);
		flex-wrap: wrap;
	}

	.ebn-google-calendar__list {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.ebn-google-calendar__grid {
		display: block;
		padding-block: 0 var(--wp--preset--spacing--2-xl);
	}

	.ebn-google-calendar__grid-header,
	.ebn-google-calendar__grid-days {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
	}

	.ebn-google-calendar__grid-events {
		display: flex;
		flex-direction: column;
		gap: var(--wp--preset--spacing--3-xs);
		position: relative;
	}

	.ebn-google-calendar__grid-event-link {
		display: inline-block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		width: 100%;
		text-decoration: none;
		line-height: var(--_block-size);
		font-size: var(--wp--preset--font-size--3-xs);
	}

	.ebn-google-calendar__tooltip {
		position: fixed;
		z-index: 10;
		pointer-events: none;
		max-width: 280px;
		padding: var(--wp--preset--spacing--xs);
		border-radius: var(--wp--custom--border-radius--xs);
		background-color: var(--wp--preset--color--neutral-white);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
		font-size: var(--wp--preset--font-size--2-xs);
		line-height: 1.4;
		color: var(--wp--preset--color--brand-primary-50);
		opacity: 0;
		transition: opacity 0.15s;
	}

	.ebn-google-calendar__tooltip.is-visible {
		opacity: 1;
	}

	.ebn-google-calendar__grid-header-dayname {
		border-right: 1px solid var(--wp--preset--color--neutral-30);
		padding: var(--wp--preset--spacing--xs);
		text-align: center;
	}

	.ebn-google-calendar__grid-day {
		border-bottom: 1px solid var(--wp--preset--color--neutral-30);
		border-right: 1px solid var(--wp--preset--color--neutral-30);
		padding: var(--wp--preset--spacing--xs);
		min-height: calc(var(--_container-width) / 7);
		display: flex;
		flex-direction: column;
		gap: var(--wp--preset--spacing--3-xs);
	}

	.ebn-google-calendar__grid-day--is-past {
		opacity: 0.4;
	}

	.ebn-google-calendar__grid-day-number {
		font-weight: var(--font-weight--semibold);
	}

	.ebn-google-calendar__grid-header,
	.ebn-google-calendar__grid-days {
		border-top: 1px solid var(--wp--preset--color--neutral-30);
		border-left: 1px solid var(--wp--preset--color--neutral-30);
	}

	.ebn-google-calendar__grid-nav {
		display: flex;
		align-items: center;
		gap: var(--wp--preset--spacing--m);
		justify-content: center;
		padding-block: var(--wp--preset--spacing--xs);
		position: relative;
		padding-inline-start: var(--wp--custom--icon-size--xs);
	}

	.ebn-google-calendar__grid-nav-month {
		min-width: 200px;
		text-align: center;
	}

	.ebn-google-calendar__grid-nav .ebn-google-calendar__grid-nav-current {
		position: absolute;
		inset-inline-start: 0;
	}

	.ebn-google-calendar__grid-nav-current .ob-button__icon {
		--_icon-mask: var(--icon-calendar);
	}
}

/*# sourceURL=https://esglesia.barcelona/es/wp-content/plugins/esglesia-next/blocks/ebn-google-calendar/style.css */
</style>
